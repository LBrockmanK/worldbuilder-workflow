{
  "types": {
    "character": {
      "fields": {
        "factions": {
          "type": "list"
        }
      },
      "template_file": "character.md"
    },
    "location": {
      "fields": {
        "region": {
          "type": "text"
        },
        "function": {
          "type": "text"
        },
        "primary-characters": {
          "type": "list"
        }
      },
      "template_file": "location.md"
    },
    "faction": {
      "fields": {
        "members": {
          "type": "list"
        },
        "function": {
          "type": "text"
        }
      },
      "template_file": "faction.md"
    },
    "event": {
      "fields": {
        "characters": {
          "type": "list"
        },
        "location": {
          "type": "text"
        },
        "layer": {
          "type": "text"
        }
      },
      "template_file": "event.md"
    },
    "concept": {
      "fields": {
        "layer": {
          "type": "text",
          "required": true
        },
        "trigger-context": {
          "type": "text"
        },
        "keywords": {
          "type": "list",
          "required": false
        }
      },
      "template_file": "concept.md"
    },
    "story": {
      "fields": {
        "scope": {
          "type": "text",
          "required": true
        },
        "up": {
          "type": "text"
        }
      },
      "template_file": "story.md"
    },
    "foundation": {
      "fields": {},
      "template_file": "foundation.md"
    },
    "plan": {
      "fields": {},
      "template_file": "plan.md"
    },
    "direction": {
      "fields": {},
      "template": ""
    },
    "reference": {
      "fields": {},
      "template": ""
    }
  },
  "tags": {
    "status": {
      "mutually_exclusive": true,
      "values": [
        "complete",
        "deprecated",
        "abandoned",
        "archived"
      ]
    },
    "behavioral": [
      "priority",
      "deferred"
    ]
  }
}

filters: file.inFolder("notes")
views:
  - type: table
    name: All
    order:
      - file.name
      - description
      - tags
      - type
      - modified
  - type: table
    name: Open
    filters:
      and:
        - '!tags.contains("complete")'
        - '!tags.contains("deprecated")'
        - '!tags.contains("abandoned")'
        - '!tags.contains("archived")'
    order:
      - file.name
      - description
      - tags
      - type
      - modified
  - type: table
    name: Complete
    filters: tags.contains("complete")
    order:
      - file.name
      - description
      - tags
      - type
      - modified
